# Server
PORT=3000
NODE_ENV=development

# Set a long random value before deploying publicly. The dashboard asks for this token.
DASHBOARD_TOKEN=change-this-to-a-long-random-secret

# Persistent directory. On Render, mount a disk at /var/data and set DATA_DIR=/var/data
DATA_DIR=./data

# Optional bot settings
BOT_NAME=OLLY MD
OWNER_NAME=Olly
OWNER_NUMBER=256700000000
PREFIX=.
